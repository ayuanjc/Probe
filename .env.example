# ---- LLM (Vercel AI SDK) ----
# Without these keys the pipeline falls back to a deterministic fixture provider,
# so the app stays runnable end-to-end with zero credentials.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PROBE_MODEL=gpt-4.1-mini

# ---- Retrieval sources ----
TAVILY_API_KEY=
# GDELT / Wikipedia pageviews / HN Algolia need no key.

# ---- Supabase (layout snapshots, pgvector) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Budgets (see PRD appendix B) ----
# 注意：PROBE_DAILY_TOKEN_BUDGET 目前没有任何代码读取（历史遗留，留着只为不破坏旧部署脚本）。
PROBE_DAILY_TOKEN_BUDGET=2000000
# 真正生效的硬预算：服务端自带 key 时每天最多发起的模型调用次数。
# 达到上限后整条链路降级为本地模板，服务继续可用但不再花钱。
# 用户自带 key（设置面板填的）不计入这个额度。
# PROBE_DAILY_LLM_CALLS=2000
PROBE_CACHE_TTL_SECONDS=21600
# 单用户每分钟检索次数上限（PRD 附录 B 要求 3）
PROBE_RATE_LIMIT_PER_MIN=3
# 其余端点各自的限流（默认值即下行）
# PROBE_TRANSLATE_RATE_LIMIT_PER_MIN=20
# PROBE_MODULE_RATE_LIMIT_PER_MIN=12
# PROBE_FEEDBACK_RATE_LIMIT_PER_MIN=5
# PROBE_VERIFY_RATE_PER_MIN=2
# PROBE_DOSSIER_RATE_LIMIT_PER_MIN=20
# PROBE_METRICS_RATE_LIMIT_PER_MIN=60

# 进程级总闸（换 IP 也绕不过去的那一道）。0 或非数字会被当成默认值，不会静默失效。
# PROBE_GLOBAL_PER_MIN=60
# PROBE_GLOBAL_VERIFY_PER_MIN=12
# PROBE_GLOBAL_MODULE_PER_MIN=120
# PROBE_GLOBAL_TRANSLATE_PER_MIN=120
# PROBE_GLOBAL_DOSSIER_PER_MIN=240
# PROBE_CRON_RATE_LIMIT_PER_MIN=10

# 并发闸门：同时真正在跑的重活数量，超出直接 503
# PROBE_SEARCH_CONCURRENCY=4
# PROBE_VERIFY_CONCURRENCY=2
# PROBE_MODULE_CONCURRENCY=3
# PROBE_TRANSLATE_CONCURRENCY=4

# ---- 来源识别（限流按谁算）----
# 在前面挡了几层反向代理。默认 1（一层 nginx，X-Forwarded-For 最右为真实 IP）。
# 直接用 `next start` 暴露在公网、前面没有代理时必须设 0，
# 否则任何人伪造 X-Forwarded-For 就能绕过全部 per-IP 限流。
# PROBE_TRUSTED_PROXY_HOPS=1

# ---- 出站抓取白名单 ----
# 允许被当作"文章地址"抓取的端口。不设则只有 80/443。
# 放宽它等于把本服务变成一个任意端口探测器，除确有需要别动。
# PROBE_FETCH_ALLOWED_PORTS=80,443

# ---- 反馈文件 ----
# .cache/feedback.jsonl 的字节上限（默认 8MB）。写满后停止接收并提示运维归档。
# PROBE_FEEDBACK_MAX_BYTES=8000000

# ---- 可选：HSTS ----
# 只有在站点确实全站 HTTPS 时才打开（当前 DEPLOY.md 是 :80 明文，保持关闭）。
# PROBE_ENABLE_HSTS=1

# ---- 邀请制授权（docs/AUTH.md）----
# 关掉就退回"谁都能用"的开放状态，只在本地调试时这么做。
# PROBE_AUTH_MODE=on
# 授权数据目录（默认 ./.data，里面是 auth/store.json，权限 0600）。记得纳入备份。
# PROBE_DATA_DIR=.data
# 登录会话有效期（小时，默认 168 = 7 天）
# PROBE_SESSION_TTL_HOURS=168
# 首次启动时若库为空，用这两个值种一个管理员；库里已有用户则完全忽略。
# 密码至少 10 位，且不能包含用户名。种出来的管理员首次登录会被要求改密码。
# PROBE_ADMIN_USER=admin
# PROBE_ADMIN_PASSWORD=
# 认证相关端点各自的限流（默认值即下行）
# PROBE_LOGIN_RATE_PER_MIN=5
# PROBE_SIGNUP_RATE_PER_MIN=3
# PROBE_PASSWORD_RATE_PER_MIN=5
# PROBE_ADMIN_RATE_PER_MIN=60

# ---- 反向代理下挂在子路径（见 docs/DEPLOY.md）----
# 两个都要设：前者决定路由注册在哪，后者会被打进前端 bundle（改了必须重新构建）
# PROBE_BASE_PATH=/probe
# NEXT_PUBLIC_PROBE_BASE_PATH=/probe
# 构建产物目录：自动更新用它把新版本先构建到 .next-staging，成功了才换过去
# PROBE_DIST_DIR=.next-staging
