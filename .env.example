# ---- LLM (Vercel AI SDK) ----
# Without these keys the pipeline falls back to a deterministic fixture provider,
# so the app stays runnable end-to-end with zero credentials.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# PROBE_MODEL=gpt-4.1-mini

# ---- Retrieval sources ----
TAVILY_API_KEY=
# GDELT / Wikipedia pageviews / HN Algolia need no key.

# ---- Supabase (layout snapshots, pgvector) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Budgets (see PRD appendix B) ----
PROBE_DAILY_TOKEN_BUDGET=2000000
PROBE_CACHE_TTL_SECONDS=21600
# 单用户每分钟检索次数上限（PRD 附录 B 要求 3）
PROBE_RATE_LIMIT_PER_MIN=3
# 其余端点各自的限流（默认值即下行：对照翻译 20、一句话生成 12、页脚反馈 5）
# PROBE_TRANSLATE_RATE_LIMIT_PER_MIN=20
# PROBE_MODULE_RATE_LIMIT_PER_MIN=12
# PROBE_FEEDBACK_RATE_LIMIT_PER_MIN=5

# ---- 反向代理下挂在子路径（见 docs/DEPLOY.md）----
# 两个都要设：前者决定路由注册在哪，后者会被打进前端 bundle（改了必须重新构建）
# PROBE_BASE_PATH=/probe
# NEXT_PUBLIC_PROBE_BASE_PATH=/probe
# 构建产物目录：自动更新用它把新版本先构建到 .next-staging，成功了才换过去
# PROBE_DIST_DIR=.next-staging
