# ---- 区域分流：一次部署，两套服务商（docs/BEIAN.md「区域分流」）----
#
# 同一次检索，走哪套服务商不看用户打什么字，只看这次请求来自哪个区域：
#   境内 → 模型白名单（默认 DeepSeek）+ 博查检索，全部不出境；
#   境外 → 下面的 OPENAI_* / TAVILY_*，构成数据出境。
# 判定顺序、白名单与兜底都在 src/lib/region.ts 与 src/lib/region-policy.ts 里，
# 找不到 CDN 国家头且没配 IP 反查时会按境内处理（判错代价不对称）。
#
# ---- LLM：境外这一路（判定为境外时才用）----
# Without these keys the pipeline falls back to a deterministic fixture provider,
# so the app stays runnable end-to-end with zero credentials.
OPENAI_API_KEY=
# 留空 = 官方 https://api.openai.com/v1。填了网关就写完整地址（要带版本路径）。
OPENAI_BASE_URL=
PROBE_MODEL=gpt-6-luna
#
# 接口地址一律要带 /v1，只接受 http(s) 绝对 URL；元数据地址（169.254.169.254 等）会被忽略。
# 其他可选兼容地址（同样带 /v1 或各自规定的版本路径）：
#   Kimi        https://api.moonshot.cn/v1
#   智谱 GLM    https://open.bigmodel.cn/api/paas/v4
#   阿里百炼    https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动    https://api.siliconflow.cn/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   本地 Ollama http://127.0.0.1:11434/v1
# 设置面板里的同名字段（x-probe-openai-base-url / x-probe-model）优先于服务端配置，
# 所以用户能临时试别家；服务端默认值以本文件为准。模型名不是白名单，填错上游返回 400。

# 想让境外这一路改用别家（同样 OpenAI 兼容）就改上面两行，
# 例如 Kimi https://api.moonshot.cn/v1 + PROBE_MODEL=kimi-k2；接口地址只接受 http(s) 绝对 URL，
# 元数据地址（169.254.169.254 等）会被忽略。设置面板里的同名字段优先于服务端配置。

# ---- LLM：境内这一路（判定为境内时强制走这里）----
# 白名单之外的端点会被拦下；配了下面三项就换成这个兜底端点并在界面上说明，没配就直接没有模型可用。
# 换服务商时同步改 src/lib/model-presets.ts 的预设表。
PROBE_CN_MODEL_KEY=
PROBE_CN_MODEL_BASE_URL=https://api.deepseek.com/v1
PROBE_CN_MODEL_ID=deepseek-flash
# 境内额外信任的模型域名（自建网关），逗号分隔。加一条等于放行一家服务商的数据出境，慎加。
# PROBE_CN_EXTRA_MODEL_HOSTS=llm.internal.example.com

# ---- 区域判定 ----
# 只服务一个区域时钉死最省事：cn | intl。留空 = 按来源判定（推荐）。
# 想在本机开发时用境外那一路，把这行写进 .env.development.local —— 那个文件只有
# next dev 读，next start 不读，本地偏好不会被生产进程继承。
# PROBE_REGION_MODE=cn
# 来源判不出来时的兜底区域（默认 cn）。
# PROBE_DEFAULT_REGION=cn
# 没接 CDN 时可填 IP 归属反查地址；含 {ip} 会替换，否则当前缀拼接。
# PROBE_REGION_LOOKUP_URL=https://ipapi.example.com/{ip}
# 境内允许的检索源（逗号分隔）。默认只有 bocha；加 tavily 等于境内也出境，别加。
# PROBE_REGION_CN_RETRIEVAL=bocha

# ---- Retrieval sources ----
# 境外检索（Tavily）。境内请求不会用到它，连集外核验也会拿到空 key。
TAVILY_API_KEY=
# GDELT / Wikipedia pageviews / HN Algolia need no key.
# ---- 境内检索（博查）。没配时境内访问退回本地演示样本，不会改走境外。----
BOCHA_API_KEY=

# ---- Supabase：目前没有任何代码读取（grep 过 src/），留着只为本机实验 ----
# 别再照着这几行去申请项目：填了也不会生效，隐私政策里也没有它。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Budgets (see PRD appendix B) ----
# 注意：PROBE_DAILY_TOKEN_BUDGET 目前没有任何代码读取（历史遗留，留着只为不破坏旧部署脚本）。
PROBE_DAILY_TOKEN_BUDGET=2000000
# 真正生效的硬预算：服务端自带 key 时每天最多发起的模型调用次数。
# 达到上限后整条链路降级为本地模板，服务继续可用但不再花钱。
# 用户自带 key（设置面板填的）不计入这个额度。
# PROBE_DAILY_LLM_CALLS=2000
# 上面那个是**进程级总量**：一个人狂刷就能把所有人的额度烧光（然后全站降级）。
# 这一条是按用户（登录态按账号、未登录按 IP）的上限，谁的额度用完谁自己降级。
# 单位是**点**，按操作记：提问 1 点、生成面板 1 点、文档核验 3 点。
# 为什么按操作而不按调用：一次核验内部最多 24 次上游调用，按调用记会让用户觉得
# 「核验一次吃掉八次提问的额度」，而且经常跑到一半被拦。30 点 ≈ 10 轮核验 或 30 次提问。
# 设 0 等于关掉这道闸。老变量 PROBE_DAILY_LLM_CALLS_PER_USER 仍被读取（值当点解）。
# PROBE_DAILY_LLM_UNITS_PER_USER=30
PROBE_CACHE_TTL_SECONDS=21600
# 单用户每分钟检索次数上限（PRD 附录 B 要求 3）
PROBE_RATE_LIMIT_PER_MIN=3
# 其余端点各自的限流（默认值即下行）
# PROBE_TRANSLATE_RATE_LIMIT_PER_MIN=20
# PROBE_MODULE_RATE_LIMIT_PER_MIN=12
# PROBE_FEEDBACK_RATE_LIMIT_PER_MIN=5
# PROBE_VERIFY_RATE_PER_MIN=2
# PROBE_DOSSIER_RATE_LIMIT_PER_MIN=20
# PROBE_METRICS_RATE_LIMIT_PER_MIN=60

# 进程级总闸（换 IP 也绕不过去的那一道）。0 或非数字会被当成默认值，不会静默失效。
# PROBE_GLOBAL_PER_MIN=60
# PROBE_GLOBAL_VERIFY_PER_MIN=12
# PROBE_GLOBAL_MODULE_PER_MIN=120
# PROBE_GLOBAL_TRANSLATE_PER_MIN=120
# PROBE_GLOBAL_DOSSIER_PER_MIN=240
# PROBE_CRON_RATE_LIMIT_PER_MIN=10

# 并发闸门：同时真正在跑的重活数量，超出直接 503
# PROBE_SEARCH_CONCURRENCY=4
# PROBE_VERIFY_CONCURRENCY=2
# PROBE_MODULE_CONCURRENCY=3
# PROBE_TRANSLATE_CONCURRENCY=4

# ---- 来源识别（限流按谁算）----
# 在前面挡了几层反向代理。默认 1（一层 nginx，X-Forwarded-For 最右为真实 IP）。
# 直接用 `next start` 暴露在公网、前面没有代理时必须设 0，
# 否则任何人伪造 X-Forwarded-For 就能绕过全部 per-IP 限流。
# PROBE_TRUSTED_PROXY_HOPS=1

# ---- 出站抓取白名单 ----
# 允许被当作"文章地址"抓取的端口。不设则只有 80/443。
# 放宽它等于把本服务变成一个任意端口探测器，除确有需要别动。
# PROBE_FETCH_ALLOWED_PORTS=80,443

# ---- 反馈文件 ----
# .cache/feedback.jsonl 的字节上限（默认 8MB）。写满后停止接收并提示运维归档。
# PROBE_FEEDBACK_MAX_BYTES=8000000

# ---- 可选：HSTS ----
# 只有在站点确实全站 HTTPS 时才打开（当前 DEPLOY.md 是 :80 明文，保持关闭）。
# PROBE_ENABLE_HSTS=1

# ---- 邀请制授权（docs/AUTH.md）----
# 关掉就退回"谁都能用"的开放状态，只在本地调试时这么做。
# 注意：=off 时每个请求都直接拿到 admin 身份，后台用户管理/审计/邀请码对任何能访问到端口的人敞开。
# 生产环境保持 on；设成 off 时服务启动会在日志里打一条醒目警告。
# PROBE_AUTH_MODE=on
# 授权数据目录（默认 ./.data，里面是 auth/store.json，权限 0600）。记得纳入备份。
# PROBE_DATA_DIR=.data
# 登录会话有效期（小时，默认 168 = 7 天）
# PROBE_SESSION_TTL_HOURS=168
# 首次启动时若库为空，用这两个值种一个管理员；库里已有用户则完全忽略。
# 密码至少 10 位，且不能包含用户名。种出来的管理员首次登录会被要求改密码。
# PROBE_ADMIN_USER=admin
# PROBE_ADMIN_PASSWORD=
# 认证相关端点各自的限流（默认值即下行）
# PROBE_LOGIN_RATE_PER_MIN=5
# 注册页「邀请码边输边验」的额度（默认 40/min；它只是查询，不需要那么严）
# PROBE_INVITE_CHECK_RATE_PER_MIN=40
# 区域信息端点 /api/region 的额度（默认 60/min，未登录也可访问）
# PROBE_REGION_RATE_PER_MIN=60
# PROBE_SIGNUP_RATE_PER_MIN=3
# PROBE_PASSWORD_RATE_PER_MIN=5
# 登录设备列表 / 踢会话（普通用户自己那两枚）
# PROBE_SESSION_RATE_PER_MIN=30
# PROBE_ADMIN_RATE_PER_MIN=60

# ---- 反向代理下挂在子路径（见 docs/DEPLOY.md）----
# 两个都要设：前者决定路由注册在哪，后者会被打进前端 bundle（改了必须重新构建）
# PROBE_BASE_PATH=/probe
# NEXT_PUBLIC_PROBE_BASE_PATH=/probe
# 构建产物目录：自动更新用它把新版本先构建到 .next-staging，成功了才换过去
# PROBE_DIST_DIR=.next-staging

# ---- 备案与合规展示（docs/BEIAN.md）----
# 下面四项只影响页脚与法律页的文字，不配置也能跑；但**正式对外提供服务时，
# 备案号是必须显示的内容**，留空等于向访客和管局隐瞒主体信息。
# 没有批下来的号一个都别填：假号比留空严重得多。
#
# ICP 备案号，格式带"粤ICP备"前缀与"-1"序号，页脚会把它链到 beian.miit.gov.cn
# PROBE_ICP_LICENSE=粤ICP备12345678号-1
#
# 公安联网备案号（备案通过后 30 日内到 beian.mps.gov.cn 办理）。
# 页脚会用其中的数字拼出查询链接。
# PROBE_POLICE_LICENSE=粤公网安备44030502008569号
#
# 页脚署名：个人写姓名，单位写营业执照名称，需与备案主体一致。
# PROBE_OPERATOR_NAME=张三
#
# 隐私政策与用户协议里公示的联系邮箱（建议与备案填写的邮箱相同）。
# 不配置时使用 src/lib/legal/contact.ts 里的默认值（ayuanjc@stu.zcst.edu.cn）；
# 用户协议、隐私政策、页脚三处共用这一个值，改一处即全站生效。
# PROBE_CONTACT_EMAIL=you@example.com

# ---- 站点身份与运维端点（代码真在读，模板此前漏写）----
# 站点对外地址：metadata / OpenGraph / sitemap 用它拼绝对链接。默认值只服务本地开发
# （http://localhost:3210），正式部署必填，否则分享出去的卡片指向 localhost。
# 已是 https 时写 https。
# PROBE_SITE_URL=https://ayuanjc.online
#
# 打在页面里的版本号（/api/version 与更新提示条读它）。留空时前端显示 0.0.0，
# 自动更新脚本可用构建时间戳或 git sha 填，便于确认线上到底是哪一版。
# NEXT_PUBLIC_PROBE_VERSION=
#
# /api/cron/heat 的口令（Heat 基线定时重建）。**不配则该端点恒返回 503**，这是刻意的默认。
# 至少 16 位，用 openssl rand -hex 32 生成；调用方带 Authorization: Bearer <值>（或 x-probe-cron-secret 头）。
# PROBE_CRON_SECRET=
#
# /api/metrics 里是否显示明文查询词：默认脱敏，配了这个值后请求头 x-probe-metrics-key
# 与之相等才显示。别和 CRON_SECRET 用同一个值。
# PROBE_METRICS_KEY=
